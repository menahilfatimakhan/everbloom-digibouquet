---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import PetalField from '../../components/PetalField.astro';
import '../../styles/components/reveal.css';

export const prerender = false;

/**
 * The bouquet is decoded in the browser, not here.
 *
 * The share link carries the whole bouquet as a compressed token in its path
 * (see lib/http.ts), and decoding it server-side is not possible with the
 * codec this project uses: lz-string 1.5 is a UMD bundle whose only CommonJS
 * branch is `typeof module !== 'undefined'`. Under Vite's SSR that is false,
 * so no branch runs and the module exports *nothing* — the import resolves to
 * an empty namespace and every token silently failed to decode. Marking it
 * ssr.noExternal does not help; the wrapper simply has no ESM path.
 *
 * Decoding on the client sidesteps that, and the page loses nothing by it: the
 * reveal was already mounted from JavaScript, so the server was only ever
 * choosing between two blocks of markup. Both are rendered now and the client
 * picks one. It also means the message never reaches the server at all.
 */
---

<BaseLayout title="A Bouquet For You">
  <section class="reveal-page" data-reveal-page>
    <PetalField count={10} />
    <div class="container reveal-page__inner">
      {/* No static heading on the reveal branch on purpose — the typed intro
         inside mountReveal() is meant to be the first thing the recipient
         reads, not spoiled by a heading above it. */}
      <div data-reveal-mount hidden></div>

      <div class="reveal-page__missing" data-reveal-missing hidden>
        <p class="eyebrow" style="text-align:center">Hm — this bouquet couldn't be found</p>
        <h1 style="text-align:center">This link has wilted.</h1>
        <p style="text-align:center">
          The bouquet you're looking for may have an incorrect link. Everbloom bouquets themselves
          never wilt — but a broken link can't hold one.
        </p>
        <p style="text-align:center">
          <a class="btn btn-primary" href="/build">Build your own bouquet</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { decodeState } from '../../builder/state/decode';
  import { mountReveal } from '../../builder/reveal/revealAnimation';
  import { PRESENTATION } from '../../builder/assetRegistry';

  const page = document.querySelector<HTMLElement>('[data-reveal-page]');
  const mount = document.querySelector<HTMLElement>('[data-reveal-mount]');
  const missing = document.querySelector<HTMLElement>('[data-reveal-missing]');

  // Last path segment, decoded — the token is percent-encoded by URL building
  // on the way out, and browsers hand it back here already decoded.
  const token = decodeURIComponent(location.pathname.split('/').filter(Boolean).pop() ?? '');
  const state = token ? decodeState(token) : null;

  if (state && mount) {
    mount.hidden = false;
    // "Mood": the sender's Color Theme also tints this page's background, and
    // nowhere else in the app. Reuses the `paper` field every theme declares.
    const theme =
      PRESENTATION.themes.find((t) => t.id === state.presentation.theme) ?? PRESENTATION.themes[0];
    page?.style.setProperty('--reveal-mood-paper', theme.paper);
    mountReveal(mount, state);
  } else if (missing) {
    missing.hidden = false;
    document.title = 'Bouquet Not Found';
  }
</script>

<style>
  .reveal-page {
    position: relative;
    padding-block: var(--space-12) var(--space-16);
    min-height: 70vh;
    background: radial-gradient(ellipse 70% 55% at 50% 18%, var(--reveal-mood-paper, transparent) 0%, transparent 72%);
    transition: background-color 0.6s ease;
  }

  .reveal-page__inner {
    position: relative;
    z-index: 1;
  }

  .reveal-page__missing {
    max-width: 30rem;
    margin: var(--space-12) auto 0;
  }
</style>
