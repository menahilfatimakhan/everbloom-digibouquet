---
import BaseLayout from '../components/layout/BaseLayout.astro';
import PetalField from '../components/PetalField.astro';
import { composePresentedBouquet } from '../builder/composition/composePresentedBouquet';
import { SCHEMA_VERSION, type BouquetState } from '../builder/state/schema';

const showcaseState: BouquetState = {
  v: SCHEMA_VERSION,
  blooms: [
    { species: 'peony', qty: 3 },
    { species: 'tulip', qty: 2 },
    { species: 'rose', qty: 2 },
    { species: 'delphinium', qty: 2 },
  ],
  arrangementSeed: 8271,
  greenery: 'eucalyptus',
  occasion: null,
  presentation: { type: 'vase', wrap: null, vase: 'glass-bud', ribbon: 'satin-bow', theme: 'lavender-dream' },
  card: { greeting: '', message: '', signature: '', font: 'monospace', theme: 'classic-cream', doodle: null },
  arrangementOverrides: {},
};

const showcase = composePresentedBouquet(showcaseState);
const showcaseSvgBody = `${showcase.materialSvg}${showcase.bloomsSvg}${showcase.ribbonSvg}`;

const steps = [
  { n: 1, label: 'Pick Blooms', copy: 'Choose 6–10 flowers, one at a time. Watch your tally grow.' },
  { n: 2, label: 'Arrange', copy: 'We compose your bouquet. Reshuffle it or swap the greenery.' },
  { n: 3, label: 'Write the Card', copy: 'A greeting, a message, a signature — in your own words.' },
  { n: 4, label: 'Send', copy: 'Get a link. They open it to a bouquet that blooms open on screen.' },
];
---

<BaseLayout title="Everbloom Digibouquet">
  <section class="hero">
    <PetalField count={14} />
    <div class="container hero__inner">
      <div class="hero__copy">
        <p class="eyebrow">Digital bouquets, built bloom by bloom</p>
        <h1 class="hero__headline">
          <span class="wordmark">Everbloom</span> never wilts.
        </h1>
        <p class="hero__sub">
          Pick your blooms, watch them arrange themselves into a bouquet, write the card,
          and send it as a link. Whoever opens it watches it bloom — today, and every time
          they open it again.
        </p>
        <div class="hero__actions">
          <a class="btn btn-primary" href="/build">Build a Bouquet</a>
          <a class="btn btn-ghost" href="#how-it-works">See how it works</a>
        </div>
      </div>
      <div class="hero__showcase" aria-hidden="true">
        <svg viewBox={showcase.viewBox} class="hero__bouquet" set:html={showcaseSvgBody} />
      </div>
    </div>
  </section>

  <section id="how-it-works" class="steps-preview">
    <div class="container">
      <p class="eyebrow" style="text-align:center">How it works</p>
      <h2 style="text-align:center">Four steps to a bouquet that keeps</h2>
      <ol class="steps-preview__grid">
        {
          steps.map((step) => (
            <li class="steps-preview__card">
              <span class="steps-preview__number">{step.n}</span>
              <h3>{step.label}</h3>
              <p>{step.copy}</p>
            </li>
          ))
        }
      </ol>
      <div class="steps-preview__cta">
        <a class="btn btn-primary" href="/build">Start Building</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    padding-block: var(--space-16) var(--space-20);
    overflow: hidden;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  @media (min-width: 60rem) {
    .hero__inner {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  .hero__headline {
    font-size: clamp(2.5rem, 6vw, 4rem);
    line-height: 1.05;
    margin-bottom: var(--space-4);
  }

  .hero__headline .wordmark {
    display: block;
    font-size: clamp(3.5rem, 9vw, 6rem);
    color: var(--color-ink-purple);
  }

  .hero__sub {
    max-width: 34rem;
    font-size: 1rem;
    color: var(--color-ink);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .hero__showcase {
    display: flex;
    justify-content: center;
  }

  .hero__bouquet {
    width: min(100%, 26rem);
    filter: drop-shadow(0 24px 40px rgba(140, 100, 170, 0.2));
  }

  /* THEME REFRESH example section (theme-refresh branch) — softer lilac-mist
     wash instead of the flatter lavender-pale, larger/rounder cards with a
     lighter shadow, more generous spacing, and a small peach accent ring on
     the number badge as the one "borrowed warmth" touch from the inspo. */
  .steps-preview {
    padding-block: var(--space-20);
    background: linear-gradient(180deg, var(--color-lilac-mist), var(--color-paper) 85%);
  }

  .steps-preview__grid {
    list-style: none;
    margin: var(--space-12) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 48rem) {
    .steps-preview__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .steps-preview__card {
    background: var(--color-paper-card);
    border-radius: var(--radius-lg);
    padding: var(--space-8) var(--space-6);
    box-shadow: var(--shadow-soft);
    text-align: left;
    transition: transform 0.25s var(--step-ease), box-shadow 0.25s var(--step-ease);
  }

  .steps-preview__card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card);
  }

  .steps-preview__number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--color-lilac-mist);
    color: var(--color-ink-purple);
    border: 1.5px solid var(--color-peach);
    font-family: var(--font-mono);
    font-weight: 700;
    margin-bottom: var(--space-4);
  }

  .steps-preview__card h3 {
    font-size: 1.15rem;
    margin-bottom: var(--space-2);
  }

  .steps-preview__card p {
    font-size: 0.85rem;
    color: var(--color-ink-purple-soft);
    margin: 0;
    line-height: 1.65;
  }

  .steps-preview__cta {
    text-align: center;
    margin-top: var(--space-12);
  }
</style>
