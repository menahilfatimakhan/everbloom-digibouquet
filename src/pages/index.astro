---
import BaseLayout from '../components/layout/BaseLayout.astro';
import PetalField from '../components/PetalField.astro';
import { composePresentedBouquet } from '../builder/composition/composePresentedBouquet';
import { SCHEMA_VERSION, type BouquetState } from '../builder/state/schema';

const showcaseState: BouquetState = {
  v: SCHEMA_VERSION,
  blooms: [
    { species: 'rose', qty: 3 },
    { species: 'gerbera-daisy', qty: 3 },
    { species: 'peony', qty: 2 },
    { species: 'lily', qty: 2 },
  ],
  // Chosen by eye from a sweep against the current art and envelope: a full,
  // rounded mass with the daisies reading at both edges and the fern fanning
  // evenly. Retune if the silhouette presets or the flower art change again.
  arrangementSeed: 295,
  greenery: 'fern',
  occasion: null,
  // No ribbon here. On the builder it's a choice the sender makes; on the hero
  // it only added a second focal point competing with the blooms.
  presentation: { type: 'vase', wrap: null, vase: 'vase-glass', ribbon: null, theme: 'blush' },
  card: { greeting: '', message: '', signature: '', font: 'monospace', theme: 'classic-cream', doodle: null },
  arrangementOverrides: {},
};

const showcase = composePresentedBouquet(showcaseState);

// Hand-tied, not arranged in a vessel: the hero shows the bouquet as it is
// gathered, so it drops materialSvg (the vase) and ribbonSvg. Only the blooms
// and their foliage are painted.
const showcaseSvgBody = showcase.bloomsSvg;

// The composed viewBox is square because it reserves room for a vessel below
// the gather. With no vase to draw, that lower third is empty, and letting it
// stand would float the bouquet in the top of its own frame. Cropped to the
// arrangement itself — the gathered stem ends sit at ~280.
const showcaseViewBox = '0 0 440 300';

const steps = [
  { n: 1, label: 'Pick Blooms', copy: 'Choose 6–10 flowers, one at a time. Watch your tally grow.' },
  { n: 2, label: 'Arrange', copy: 'We compose your bouquet. Reshuffle it or swap the greenery.' },
  { n: 3, label: 'Write the Card', copy: 'A greeting, a message, a signature — in your own words.' },
  { n: 4, label: 'Send', copy: 'Get a link. They open it to a bouquet that blooms open on screen.' },
];
---

<BaseLayout title="Everbloom Digibouquet" headerGround="deep">
  <section class="hero" data-ground="deep">
    <div class="hero__glow" aria-hidden="true"></div>
    <PetalField count={14} />
    <div class="container hero__inner">
      <div class="hero__copy">
        <p class="eyebrow" data-hero-reveal>Digital bouquets, built bloom by bloom</p>
        <h1 class="hero__headline" data-hero-reveal>
          <span class="wordmark">Everbloom</span> never wilts.
        </h1>
        <p class="hero__sub" data-hero-reveal>
          Pick your blooms, watch them arrange themselves into a bouquet, write the card,
          and send it as a link. Whoever opens it watches it bloom — today, and every time
          they open it again.
        </p>
        <div class="hero__actions" data-hero-reveal>
          <a class="btn btn-primary" href="/build">Build a Bouquet</a>
          <a class="btn btn-ghost" href="#how-it-works">See how it works</a>
        </div>
      </div>
      <div class="hero__showcase" aria-hidden="true">
        <!-- The signature moment: the bouquet sits in its own pool of light.
             A soft radial wash rather than a framed panel — a hard-edged frame
             has to be sized to the artwork, and any bloom reaching past it
             read as spilling out of a box that was too small. A gradient has
             no edge to outgrow. -->
        <div class="hero__stage" data-hero-stage>
          <div class="hero__halo"></div>
          <svg viewBox={showcaseViewBox} class="hero__bouquet" set:html={showcaseSvgBody} />
        </div>
      </div>
    </div>
  </section>

  <section id="how-it-works" class="steps-preview">
    <div class="container">
      <p class="eyebrow" style="text-align:center">How it works</p>
      <h2 style="text-align:center">Four steps to a bouquet that keeps</h2>
      <ol class="steps-preview__grid">
        {
          steps.map((step) => (
            <li class="steps-preview__card">
              <span class="steps-preview__number">{step.n}</span>
              <h3>{step.label}</h3>
              <p>{step.copy}</p>
            </li>
          ))
        }
      </ol>
      <div class="steps-preview__cta">
        <a class="btn btn-primary" href="/build">Start Building</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------------------------------------------------------------
     HERO — the one deep-ground section in the app.
     --------------------------------------------------------------- */

  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: linear-gradient(168deg, var(--color-plum) 0%, #2a1440 52%, var(--color-plum) 100%);
    /* Top padding clears the header, which is overlaid rather than stacked. */
    padding-block: clamp(7rem, 14vh, 9.5rem) var(--section-y);
    min-height: min(100svh, 46rem);
    display: flex;
    align-items: center;
  }

  /* Ambient light behind the bouquet — the "lit window" the florals glow in.
     Purely decorative, sits under everything. */
  .hero__glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(ellipse 55% 50% at 74% 40%, rgba(91, 42, 133, 0.6), transparent 70%),
      radial-gradient(ellipse 70% 55% at 12% 88%, rgba(107, 47, 160, 0.24), transparent 72%);
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
    align-items: center;
    width: 100%;
  }

  @media (min-width: 60rem) {
    .hero__inner {
      grid-template-columns: 1.05fr 0.95fr;
      gap: var(--space-16);
    }
  }

  .hero__headline {
    font-size: var(--display-lg);
    margin-bottom: var(--space-5);
    color: var(--color-on-deep);
  }

  .hero__headline .wordmark {
    display: block;
    font-size: var(--display-xl);
    line-height: 0.95;
    margin-bottom: 0.08em;
    color: var(--color-on-deep);
  }

  .hero__sub {
    max-width: 32rem;
    font-size: var(--text-md);
    line-height: var(--leading-body);
    color: var(--color-on-deep-muted);
    margin-bottom: 0;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  /* The ghost button carries inline padding so it sits correctly beside the
     primary one. Once it wraps onto its own line that padding reads as a
     stray indent, so pull it back into alignment. */
  @media (max-width: 26rem) {
    .hero__actions .btn-ghost {
      margin-inline-start: calc(var(--space-3) * -1);
    }
  }

  .hero__showcase {
    display: flex;
    justify-content: center;
  }

  .hero__stage {
    position: relative;
    /* Wider than it would be for a square frame: the hand-tied bouquet is
       cropped to a 440x300 box, so a width tuned for a square composition
       leaves it reading small against the headline beside it. */
    width: min(100%, 36rem);
    display: flex;
    justify-content: center;

    /* Continuously floated by GSAP — give it a compositor layer up front. */
    will-change: transform;
  }

  /* The pool of light the bouquet stands in. Overflows the stage on every side
     so it can never be "too small" for the artwork the way a framed panel was;
     it simply falls off to nothing before it reaches the section edges.

     Two stops rather than one: a tight warm core that lifts the blooms off the
     plum ground, and a wide cool falloff that keeps the transition from
     banding against the hero's own gradient. */
  .hero__halo {
    position: absolute;
    /* Generous overflow so the fade has room to finish *inside* the element.
       A radial-gradient is still clipped to its own box, so an ending shape
       wider than the box gets sliced off flat at the edges — which is what
       drew a hard-edged rectangle around the bouquet at the previous 78%. */
    inset: -70% -40%;
    z-index: -1;
    pointer-events: none;
    /* Every radius stays well under 50%, so both washes reach zero with room
       to spare on all four sides. Fading to an explicit alpha-0 of the *same*
       hue, not `transparent`: the keyword resolves to rgba(0,0,0,0), and
       interpolating toward it drags a grey cast through the midtones. */
    background:
      radial-gradient(ellipse 24% 26% at 50% 46%, rgba(255, 241, 250, 0.2), rgba(255, 241, 250, 0)),
      radial-gradient(ellipse 34% 36% at 50% 47%, rgba(158, 106, 205, 0.28), rgba(158, 106, 205, 0));
  }

  .hero__bouquet {
    position: relative;
    width: 100%;
    /* The composed bouquet is a large multi-path SVG, and the new artwork is
       heavier still. Promoting the animated wrapper to its own layer (below)
       keeps the drop-shadow rasterised once instead of on every frame of the
       float, which is what would otherwise cost us on mobile. */
    filter: drop-shadow(0 28px 48px rgba(12, 5, 20, 0.55));
  }

  .steps-preview {
    padding-block: var(--space-16);
    background: var(--color-lavender-pale);
  }

  .steps-preview__grid {
    list-style: none;
    margin: var(--space-12) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 48rem) {
    .steps-preview__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .steps-preview__card {
    background: var(--color-paper-card);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    box-shadow: var(--shadow-soft);
    text-align: left;
  }

  .steps-preview__number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--color-ink-purple-pale);
    color: var(--color-ink-purple);
    font-family: var(--font-mono);
    font-weight: 700;
    margin-bottom: var(--space-3);
  }

  .steps-preview__card h3 {
    font-size: 1.15rem;
    margin-bottom: var(--space-2);
  }

  .steps-preview__card p {
    font-size: 0.85rem;
    color: var(--color-ink-purple-soft);
    margin: 0;
  }

  .steps-preview__cta {
    text-align: center;
    margin-top: var(--space-12);
  }
</style>

<script>
  // Reuses the shared GSAP + reduced-motion helpers rather than reaching for
  // gsap directly, so hero motion obeys the same switch as the builder.
  import { gsap, prefersReducedMotion } from '../builder/animation/gsapSetup';

  function initHero() {
    if (prefersReducedMotion()) return;

    const reveals = document.querySelectorAll<HTMLElement>('[data-hero-reveal]');
    const stage = document.querySelector<HTMLElement>('[data-hero-stage]');

    // gsap.from() applies the start state on the same frame it runs, so the
    // markup stays visible for anyone without JS instead of being stranded
    // at opacity 0.
    if (reveals.length) {
      gsap.from(reveals, {
        y: 18,
        opacity: 0,
        duration: 0.7,
        ease: 'power2.out',
        stagger: 0.09,
      });
    }

    if (stage) {
      gsap
        .timeline()
        .from(stage, { opacity: 0, scale: 0.965, duration: 0.9, ease: 'power2.out' }, 0.15)
        // Settles into a slow drift once it has arrived — the bouquet is
        // meant to feel held, not animated at.
        .to(stage, {
          y: -10,
          duration: 6,
          repeat: -1,
          yoyo: true,
          ease: 'sine.inOut',
        });
    }
  }

  initHero();
</script>
