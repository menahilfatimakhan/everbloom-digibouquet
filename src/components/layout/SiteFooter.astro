---
import logoMark from '../../assets/svg/decorative/logo-mark.svg?raw';

const INSTAGRAM_URL = 'https://www.instagram.com/everbloombymeena/';
const INSTAGRAM_HANDLE = '@everbloombymeena';
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <span class="site-footer__mark" set:html={logoMark} />
      <div>
        <p class="wordmark site-footer__wordmark">Everbloom</p>
        <p class="site-footer__tagline">An Everbloom bouquet never wilts.</p>
      </div>
    </div>
    <a class="site-footer__instagram" href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="5" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="17.3" cy="6.7" r="1.1" fill="currentColor" stroke="none" />
      </svg>
      {INSTAGRAM_HANDLE}
    </a>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-16);
    border-top: 1px solid var(--color-ink-purple-pale);
    padding-block: var(--space-8);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .site-footer__brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .site-footer__mark {
    width: 2rem;
    height: 2.3rem;
    flex-shrink: 0;
    opacity: 0.85;
  }

  .site-footer__mark :global(svg) {
    width: 100%;
    height: 100%;
  }

  .site-footer__wordmark {
    font-size: 1.35rem;
    margin: 0;
    color: var(--color-ink-purple);
  }

  .site-footer__tagline {
    margin: 0;
    font-size: 0.75rem;
    color: var(--color-ink-purple-soft);
  }

  .site-footer__instagram {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    text-decoration: none;
    color: var(--color-ink-purple);
    border: 1.5px solid var(--color-ink-purple-pale);
    padding: 0.55rem 1rem;
    border-radius: 999px;
    transition: border-color 0.2s var(--step-ease), transform 0.2s var(--step-ease);
  }

  .site-footer__instagram:hover {
    border-color: var(--color-ink-purple);
    transform: translateY(-2px);
  }
</style>
