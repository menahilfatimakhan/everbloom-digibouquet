---
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import '../../styles/global.css';

interface Props {
  title: string;
  description?: string;
  minimalChrome?: boolean;
  /**
   * 'deep' means this page opens on the plum hero, so the header overlays it
   * and inverts. Everything else runs on the light lavender-pearl ground.
   */
  headerGround?: 'light' | 'deep';
}

const {
  title,
  description = 'Everbloom Digibouquet — build a custom bouquet bloom by bloom and send it as an animated keepsake.',
  minimalChrome = false,
  headerGround = 'light',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · Everbloom</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} · Everbloom`} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    {!minimalChrome && <SiteHeader ground={headerGround} />}
    <slot />
    {!minimalChrome && <SiteFooter />}
  </body>
</html>
